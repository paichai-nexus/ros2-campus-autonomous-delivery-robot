<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="campus_robot">

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.70 0.50 0.25"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <box size="0.70 0.50 0.25"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="25.0"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="0.60"
        ixy="0"
        ixz="0"
        iyy="0.90"
        iyz="0"
        izz="1.10"/>
    </inertial>
  </link>

  <link name="laser_link"/>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.20 0 0.20" rpy="0 0 0"/>
  </joint>

</robot>
